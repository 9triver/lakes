[Unit]
Description=Lakes Workbench Python backend
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lakes
Environment=PYTHONPATH=%h/lakes/src
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/lakes/.venv/bin/python -m lake_workbench.server --host 0.0.0.0 --port 18765
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
